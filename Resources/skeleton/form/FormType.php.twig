namespace {{ namespace }}\Form{{ entity_namespace ? '\\' ~ entity_namespace : '' }};

use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\OptionsResolver\OptionsResolverInterface;

/**
 * Form type class for {{ entity_class }} entity
 *
 * @package 
 * @author  
 */
class {{ form_class }} extends AbstractType
{
    /**
     * Defines form fields of current form type
     * @param FormBuilderInterface $builder Instance of FormBuilder
     * @param array                $options Options configuring form
     *
     * @author  
     */
    public function buildForm(FormBuilderInterface $builder, array $options)
    {
        {%- for field in fields %}

            $builder->add('{{ field }}');

        {%- endfor %}

    }

    /**
     * Sets default options
     * @param OptionsResolverInterface $resolver Instance of options resolver
     *
     * @author  
     */
    public function setDefaultOptions(OptionsResolverInterface $resolver)
    {
        $resolver->setDefaults(array(
            'data_class' => '{{ namespace }}\Entity{{ entity_namespace ? '\\' ~ entity_namespace : '' }}\{{ entity_class }}'
        ));
    }

    /**
     * Exposes form type name
     * 
     * @author
     * @return string form type name  
     */
    public function getName()
    {
        return '{{ form_type_name }}';
    }
}
